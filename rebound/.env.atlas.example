# Atlas ATRIP Sandbox configuration
# Copy these variables into your local .env file, then fill in freshly generated
# Sandbox keys from ATRIP. Never commit the real .env file or share these keys.

ATLAS_ENV=sandbox
ATLAS_SANDBOX_ENABLED=true
ATLAS_BASE_URL=https://sandbox.atriptech.com
ATLAS_ACCESS_KEY=
ATLAS_SECRET_KEY=
